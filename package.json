{
  "name": "reviewd",
  "version": "0.1.0",
  "description": "Local-first code review for working with coding agents, with a commit gate that holds code until a human has read it",
  "license": "MIT",
  "repository": "github:bamsammich/reviewd",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "reviewd": "./dist/cli.js"
  },
  "files": [
    "dist",
    "contrib",
    "plugin",
    ".claude-plugin/marketplace.json"
  ],
  "scripts": {
    "build": "tsc --build",
    "prepare": "npm run build",
    "version": "node scripts/sync-plugin-version.mjs && git add plugin/.claude-plugin/plugin.json",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "diff": "^9.0.0",
    "hono": "^4.13.3",
    "kysely": "^0.29.0",
    "shiki": "^4.4.3",
    "uuid": "^14.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "@types/node": "^24.0.0",
    "eslint": "^9.20.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.0"
  }
}
